{% extends 'base.html.twig' %}

{% block title %}Mes inscriptions{% endblock %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Mes inscriptions</h1>
            {% if events is not empty %}
                <p class="muted">Vous êtes inscrit à {{ events|length }} événement(s).</p>
            {% endif %}
        </div>
    </div>

    {% if events is empty %}
        <p class="empty">Vous n'êtes inscrit à aucun événement pour le moment.</p>
    {% else %}
        <ul class="event-list">
            {% for event in events %}
                {{ include('event/_card.html.twig', { event: event, showUnregister: true }) }}
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}